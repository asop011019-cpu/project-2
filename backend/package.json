{
  "name": "project-2-onboarding-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run format:check && npm run typecheck && npm test",
    "db:migrate": "node --env-file-if-exists=.env src/scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env src/scripts/seed.ts",
    "catalog:import": "node --env-file-if-exists=.env src/scripts/import-catalog.ts",
    "catalog:export": "node --env-file-if-exists=.env src/scripts/export-catalog.ts",
    "format": "prettier --write src test package.json tsconfig.json",
    "format:check": "prettier --check src test package.json tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.6",
    "fastify": "5.12.7",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
