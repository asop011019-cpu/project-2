HOST=127.0.0.1
PORT=3001
# Mount on persistent storage in production. Relative paths resolve from backend/.
DATABASE_PATH=./data/onboarding.sqlite
ASSET_ROOT=./assets
# Browser-facing origin; frontend development should proxy /api and /media here.
PUBLIC_ORIGIN=http://localhost:3001
NODE_ENV=development
# Production requires HTTPS and always sets Secure cookies.
